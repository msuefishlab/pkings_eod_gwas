# Shared configuration for every pipeline script. Source it from the repository root before running anything:
#
#     source config.env
#
# Edit only the "site-specific" block. Everything else is derived from the repository layout.

# ---- site-specific: edit these ----
# Large intermediate files (sweep scans, simulations). Defaults to $SCRATCH on a cluster, else ./scratch.
export scratch_dir="${scratch_dir:-${SCRATCH:-$(git rev-parse --show-toplevel)/scratch}}"
# Cloud bucket used by the Terra variant-calling workflow (01_Terra) and by the scripts that stage reads.
# Set this to your own bucket name (the bare name, without a URL scheme) if you rerun those steps.
export bucket="${bucket:-YOUR_BUCKET_NAME}"
# Directory holding the SPTBN4 immunohistochemistry .lif files (16_IHC).
export sptbn4_ihc_dir="${sptbn4_ihc_dir:-$(git rev-parse --show-toplevel)/input_data/16_IHC}"

# ---- repository layout ----
export root="$(git rev-parse --show-toplevel)"

# Singularity images, built from the definitions in images/ (see images/README.md)
export gatk_image=${root}/images/gatk_4.3.0.0.sif
export gwas_tools_image=${root}/images/gwas_tools.sif
export rmats_image=${root}/images/rmats_turbo.sif
export liftoff_image=${root}/images/liftoff.sif
export rnaseq_tools_image=${root}/images/rnaseq_tools.sif
export ggsashimi_image=${root}/images/ggsashimi_latest.sif
export sweepfinder2_image=${root}/images/sweepfinder2.sif
export sweed_image=${root}/images/sweed.sif
export rehh_image=${root}/images/rehh.sif
export dadi_image=${root}/images/dadi_tools.sif

# Echo a command, then run it
run_command() {
    echo $@
    eval $@
}

# ---- reference genome (input_data/00_Reference_Genome; see README "Reference genome") ----
export original_reference=jordan-mic4273-mb-hirise-20xx3__06-13-2024__final_assembly.fasta
export reference=jordan-mic4273-mb-hirise-20xx3__06-13-2024__final_assembly.fasta.renamed.fa
export chr_name_map=jordan-mic4273-mb-hirise-20xx3__06-13-2024__final_assembly.fasta.chrnames
gff_file=jordan-mic4273-mb-hirise-20xx3__06-13-2024__final_assembly.fasta.renamed.sorted.genes_only.gff
annotation_gff=jordan-mic4273-mb-hirise-20xx3__06-13-2024__final_assembly.ensembl.liftoff.renamed.gtf

# ---- variant call sets (produced by 01_Terra and 03_VCF_QC_Filter) ----
export vcf_file=MIC4273_HAP2_NEWREF_MSU618_all_fish_all_sites.raw.vcf.gz
export snps_only_vcf=MIC4273_HAP2_NEWREF_MSU618_all_fish_all_sites.FILTERED_BIALLELIC_SNPS_ONLY.renamed.vcf.gz
export invariant_and_snps_vcf=MIC4273_HAP2_NEWREF_MSU618_all_fish_all_sites.FILTERED_BIALLELIC_AND_INVARIANT.renamed.vcf.gz
export allsites_vcf=${invariant_and_snps_vcf}
export snps_only_for_phasing=MIC4273_HAP2_NEWREF_MSU618_all_fish_all_sites.FILTERED_BIALLELIC_SNPS_ONLY.vcf.gz
export phased_vcf=MIC4273_HAP2_NEWREF_MSU618_all_fish_all_sites.FILTERED_BIALLELIC_SNPS_ONLY.phased.renamed.vcf.gz
export outgroup=PSZA_459

# ---- population genetics (05_PopGen) ----
export popsfile=popsfile.txt
export popgen_prefix=MIC4273_HAP2_NEWREF_MSU618_all_fish_all_sites

# ---- sweep detection (11_Drift_vs_Selection) ----
export sweep_scratch=${scratch_dir}/pkings_sweeps

# ---- TFBS scan (15_TFBS_Scan) ----
export phased_VCF=${root}/output_data/07_Phasing/${phased_vcf}
export TFBS_VCF=${root}/output_data/15_TFBS_Scan/PKINGS_ALL_WOB_EXCLUDED_SNPS_IN_PEAKS_TOP250.vcf.gz
export TFBS_SNP_METADATA=${root}/input_data/15_TFBS_Scan/PKINGS_ALL_WOB_EXCLUDED_SNPS_IN_PEAKS.txt
export JASPAR_MOTIFS=${root}/input_data/15_TFBS_Scan/JASPAR2024_CORE_vertebrates_non-redundant_pfms_meme.txt
export TFBS_GFF=${root}/input_data/00_Reference_Genome/paramormyrops_ncbi_0.4.renamed.gff
export TFBS_REF=${root}/input_data/00_Reference_Genome/${reference}
