#!/bin/bash --login

########## Define Resources Needed with SBATCH Lines ##########

#SBATCH --time=02:00:00             # limit of wall clock time - how long the job will run (same as -t)
#SBATCH --ntasks=1                  # number of tasks - how many tasks (nodes) that you require (same as -n)
#SBATCH --cpus-per-task=2           # number of CPUs (or cores) per task (same as -c)
#SBATCH --mem=16G                   # memory required per node - amount of memory (in bytes)
#SBATCH --array=0-24                # one task per chromosome
#SBATCH --job-name RefBiasStats     # you can give your job a name for easier identification (same as -J)
########## Command Lines to Run ##########

# Per-sample depth, missingness and het allele balance by region class, one chromosome per task.
# Regions: output_data/03_QC/ref_bias/ref_bias_regions.bed (code/03_VCF_QC_Filter/ref_bias_make_regions.py)
# Usage: sbatch --export=root=$root code/03_VCF_QC_Filter/ref_bias_stats.sb

source $root/config.env

module purge
module load BCFtools/1.19-GCC-13.2.0
module load SciPy-bundle/2023.11-gfbf-2023b

# Raw all-sites VCF from joint genotyping (01_Terra), with its .tbi index
vcf=${root}/output_data/01_Terra/${vcf_file}
[ -s "$vcf" ] && [ -s "${vcf}.tbi" ] || { echo "missing $vcf (+ .tbi); produce it with 01_Terra"; exit 1; }
outdir=${root}/output_data/03_QC/ref_bias
bed=${outdir}/ref_bias_regions.bed
mkdir -p ${outdir}/per_chrom

scaf=$(cut -f1,5 $bed | sort -u | sort -k2,2V | cut -f1 | sed -n "$((SLURM_ARRAY_TASK_ID + 1))p")
echo "task ${SLURM_ARRAY_TASK_ID}: ${scaf}"

python3 ${root}/code/03_VCF_QC_Filter/ref_bias_stats.py $vcf $bed $scaf ${outdir}/per_chrom/${scaf}.tsv
