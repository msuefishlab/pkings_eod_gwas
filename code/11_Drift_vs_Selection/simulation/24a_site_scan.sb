#!/bin/bash
#SBATCH --job-name=clust_scan
#SBATCH --cpus-per-task=8
#SBATCH --mem=8G
#SBATCH --time=01:00:00
#SBATCH --output=logs/%x_%j.out
## Empirical clustering test: run 24a_site_scan.py over every site-table chunk, 8 at a time, then concatenate.
## ST = absolute path of the drift test's site table,
##      output_data/11_Drift_vs_Selection/demographic_modeling/fixed_differences_agree/site_table
## Usage (from the repository root; the job runs in W, which needs a logs/ subdirectory):
##   sbatch -D "${W}" --export=ALL,root=$(pwd),W="${W}",ST=<site_table_dir> code/11_Drift_vs_Selection/simulation/24a_site_scan.sb
set -euo pipefail
cd "${W}"
mkdir -p scan
PY=${MSPRIME_PYTHON:-python3}
S=${root:?set root to the repository root}/code/11_Drift_vs_Selection/simulation
ls "${ST}"/snps.*.tsv.gz | xargs -P 8 -I{} sh -c \
  '"$0" "$2" "$1" "scan/$(basename "$1" .tsv.gz)"' "${PY}" {} "${S}/24a_site_scan.py"
n_in=$(ls "${ST}"/snps.*.tsv.gz | wc -l)
n_out=$(ls scan/*.bins.tsv | wc -l)
echo "chunks in ${n_in}, out ${n_out}"
[ "${n_in}" -eq "${n_out}" ]
cat scan/*.qual.tsv | sort -k1,1V -k2,2n > 24a_qualifying.tsv
cat scan/*.bins.tsv | sort -k1,1V -k2,2n > 24a_density_1kb.tsv
wc -l 24a_qualifying.tsv 24a_density_1kb.tsv
